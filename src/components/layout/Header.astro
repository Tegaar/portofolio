---
import { navigationItems, siteIdentity } from '../../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="container header-content">
    <a class="brand" href={siteIdentity.homePath} aria-label={`${siteIdentity.brand} — home`}>
      {siteIdentity.brand}<span class="brand-dot" aria-hidden="true"></span>
    </a>
    <div class="header-actions">
      <nav aria-label="Primary navigation">
        <ul class="navigation-list">
          {navigationItems.map((item) => (
            <li>
              <a
                class="navigation-link"
                href={item.href}
                aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--layer-header);
    background: var(--surface-page);
    border-bottom: 1px solid var(--border-default);
  }

  @supports (backdrop-filter: blur(12px)) {
    .site-header {
      background: color-mix(in srgb, var(--surface-page) 92%, transparent);
      backdrop-filter: blur(12px);
    }
  }

  .header-content,
  .header-actions,
  .navigation-list {
    display: flex;
    align-items: center;
  }

  .header-content {
    min-height: var(--header-height);
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    min-height: var(--control-size);
    padding-block: var(--space-2);
    font-size: 1.125rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    line-height: 1.5;
    color: var(--text-primary);
    text-decoration: none;
  }

  .brand-dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: var(--radius-pill);
    background: var(--accent-primary);
  }

  .header-actions {
    gap: var(--space-4);
  }

  .navigation-list {
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--control-size);
    min-height: var(--control-size);
    padding-inline: var(--space-2);
    border-bottom: 2px solid transparent;
    color: var(--text-secondary);
    font-size: var(--text-small);
    font-weight: 550;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .navigation-link[aria-current='page'] {
    border-bottom-color: var(--accent-primary);
    color: var(--text-primary);
  }

  @media (hover: hover) {
    .navigation-link:hover {
      color: var(--accent-hover);
    }
  }

  @media (max-width: 30rem) {
    .header-actions {
      gap: var(--space-2);
    }
  }
</style>
